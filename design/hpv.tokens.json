{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Hawaiian Plantation Village design tokens — creative brief 2026. Canonical source for Figma (Tokens Studio) and docs/HPV_Style_Guide.html. Runtime CSS lives in src/index.css; keep names aligned.",
  "meta": {
    "name": "HPV Design Tokens",
    "version": "1.0.0",
    "brand": "Hawaiian Plantation Village",
    "fontsUrl": "https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Inter:wght@400;500;600&display=swap",
    "cssSource": "src/index.css",
    "contrastScript": "scripts/contrast-check.mjs",
    "voice": "Warm, specific, inviting — descendant voice, not press release. Sentence case. One gold CTA per view. Gold = act, clay = give."
  },
  "color": {
    "brand": {
      "plantation-ink": {
        "$type": "color",
        "$value": "#1c2b22",
        "$description": "Primary ink — text, nav, primary buttons"
      },
      "plantation-ink-soft": {
        "$type": "color",
        "$value": "#2a3d31",
        "$description": "Ink hover / soft fill"
      },
      "heritage-gold": {
        "$type": "color",
        "$value": "#d98e04",
        "$description": "Primary action (CTA) fill"
      },
      "heritage-gold-deep": {
        "$type": "color",
        "$value": "#c98304",
        "$description": "Gold CTA hover"
      },
      "heritage-gold-ink": {
        "$type": "color",
        "$value": "#8a5a02",
        "$description": "Gold text on cream/sand (WCAG AA)"
      },
      "terracotta-clay": {
        "$type": "color",
        "$value": "#b5502e",
        "$description": "Give / donate accent fill"
      },
      "terracotta-clay-deep": {
        "$type": "color",
        "$value": "#97401f",
        "$description": "Clay hover and clay text on light surfaces"
      },
      "sugarcane-cream": {
        "$type": "color",
        "$value": "#faf6ec",
        "$description": "Primary page surface"
      },
      "sand": {
        "$type": "color",
        "$value": "#f0e9d8",
        "$description": "Secondary surface / section band"
      },
      "muted-sage": {
        "$type": "color",
        "$value": "#61685e",
        "$description": "Supporting / muted text"
      }
    },
    "supporting": {
      "ocean-teal": {
        "$type": "color",
        "$value": "#3f5c4c",
        "$description": "Link colour"
      },
      "ocean-teal-light": {
        "$type": "color",
        "$value": "#2f4739",
        "$description": "Link hover"
      },
      "koa-wood-dark": {
        "$type": "color",
        "$value": "#101a14",
        "$description": "Deepest ink (legacy koa-wood-dark)"
      },
      "kraft-tan-dark": {
        "$type": "color",
        "$value": "#ddd3bd",
        "$description": "Subtle border tint (legacy)"
      }
    },
    "border": {
      "hairline": {
        "$type": "color",
        "$value": "rgba(28, 43, 34, 0.14)",
        "$description": "Default hairline on cream/sand"
      },
      "hairline-strong": {
        "$type": "color",
        "$value": "rgba(28, 43, 34, 0.24)",
        "$description": "Stronger hairline / ghost button border"
      },
      "hairline-invert": {
        "$type": "color",
        "$value": "rgba(250, 246, 236, 0.22)",
        "$description": "Hairline on ink surfaces"
      }
    },
    "semantic": {
      "surface": {
        "cream": {
          "$type": "color",
          "$value": "{color.brand.sugarcane-cream}",
          "$description": "Default page background"
        },
        "sand": {
          "$type": "color",
          "$value": "{color.brand.sand}",
          "$description": "Alternating section background"
        },
        "ink": {
          "$type": "color",
          "$value": "{color.brand.plantation-ink}",
          "$description": "Inverted / hero band"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{color.brand.plantation-ink}",
          "$description": "Body and headings on light surfaces"
        },
        "muted": {
          "$type": "color",
          "$value": "{color.brand.muted-sage}",
          "$description": "Supporting copy"
        },
        "on-ink": {
          "$type": "color",
          "$value": "{color.brand.sugarcane-cream}",
          "$description": "Headings on ink"
        },
        "on-ink-muted": {
          "$type": "color",
          "$value": "rgba(250, 246, 236, 0.78)",
          "$description": "Body on ink (~78% cream)"
        },
        "gold": {
          "$type": "color",
          "$value": "{color.brand.heritage-gold-ink}",
          "$description": "Gold text on light surfaces"
        },
        "clay": {
          "$type": "color",
          "$value": "{color.brand.terracotta-clay-deep}",
          "$description": "Clay accent text / Give link"
        }
      },
      "cta": {
        "primary": {
          "$type": "color",
          "$value": "{color.brand.plantation-ink}",
          "$description": ".btn-primary fill"
        },
        "accent": {
          "$type": "color",
          "$value": "{color.brand.heritage-gold}",
          "$description": ".btn-accent — one gold act per view"
        },
        "accent-hover": {
          "$type": "color",
          "$value": "{color.brand.heritage-gold-deep}"
        },
        "give": {
          "$type": "color",
          "$value": "{color.brand.terracotta-clay}",
          "$description": ".btn-clay — donate / give moments"
        },
        "give-hover": {
          "$type": "color",
          "$value": "{color.brand.terracotta-clay-deep}"
        },
        "on-accent": {
          "$type": "color",
          "$value": "{color.brand.plantation-ink}",
          "$description": "Label on gold CTA"
        },
        "on-give": {
          "$type": "color",
          "$value": "{color.brand.sugarcane-cream}",
          "$description": "Label on clay CTA"
        },
        "on-primary": {
          "$type": "color",
          "$value": "{color.brand.sugarcane-cream}",
          "$description": "Label on ink CTA"
        }
      }
    },
    "legacy": {
      "$description": "Code compatibility only — omitted from Figma primary sets. Map to brand tokens in new work.",
      "cane-green": { "$type": "color", "$value": "{color.brand.plantation-ink}" },
      "cane-green-light": { "$type": "color", "$value": "{color.brand.plantation-ink-soft}" },
      "sugar-gold": { "$type": "color", "$value": "{color.brand.heritage-gold-ink}" },
      "tin-rust": { "$type": "color", "$value": "{color.brand.terracotta-clay-deep}" },
      "kraft-tan": { "$type": "color", "$value": "{color.brand.sand}" },
      "koa-wood": { "$type": "color", "$value": "{color.brand.plantation-ink}" },
      "paper-light": { "$type": "color", "$value": "{color.brand.sugarcane-cream}" },
      "paper-dark": { "$type": "color", "$value": "{color.brand.sand}" },
      "text-dark": { "$type": "color", "$value": "{color.brand.plantation-ink}" },
      "text-muted": { "$type": "color", "$value": "{color.brand.muted-sage}" }
    }
  },
  "fontFamily": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Fraunces", "Georgia", "serif"],
      "$description": "Editorial display / headings"
    },
    "body": {
      "$type": "fontFamily",
      "$value": ["Inter", "system-ui", "sans-serif"],
      "$description": "Body copy"
    },
    "sans": {
      "$type": "fontFamily",
      "$value": ["Inter", "system-ui", "sans-serif"],
      "$description": "UI / nav / buttons"
    }
  },
  "typography": {
    "display": {
      "hero": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.display}",
          "fontWeight": 500,
          "fontSize": {
            "min": "2.5rem",
            "preferred": "6.4vw",
            "max": "5rem",
            "css": "clamp(2.5rem, 6.4vw, 5rem)"
          },
          "lineHeight": 1.02,
          "letterSpacing": "-0.025em"
        },
        "$description": ".hero-headline"
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.display}",
          "fontWeight": 500,
          "fontSize": {
            "min": "2rem",
            "preferred": "4.2vw",
            "max": "3.1rem",
            "css": "clamp(2rem, 4.2vw, 3.1rem)"
          },
          "lineHeight": 1.08,
          "letterSpacing": "-0.015em"
        },
        "$description": ".editorial-title"
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.display}",
          "fontWeight": 600,
          "fontSize": "2rem",
          "lineHeight": 1.12,
          "letterSpacing": "-0.015em",
          "fontVariationSettings": "'SOFT' 40, 'WONK' 0"
        },
        "$description": "Default h1–h6"
      }
    },
    "body": {
      "default": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.body}",
          "fontWeight": 400,
          "fontSize": "1rem",
          "lineHeight": 1.6,
          "letterSpacing": "0"
        }
      },
      "lede": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.body}",
          "fontWeight": 400,
          "fontSize": "1.05rem",
          "lineHeight": 1.7,
          "letterSpacing": "0"
        },
        "$description": ".editorial-lede"
      }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontWeight": 600,
        "fontSize": "0.72rem",
        "lineHeight": 1.4,
        "letterSpacing": "0.16em",
        "textTransform": "uppercase"
      },
      "$description": ".editorial-eyebrow"
    },
    "ui": {
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": 600,
          "fontSize": "0.95rem",
          "lineHeight": 1.2,
          "letterSpacing": "0",
          "textTransform": "none"
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": 500,
          "fontSize": "0.92rem",
          "lineHeight": 1.2,
          "letterSpacing": "0"
        }
      }
    },
    "caption": {
      "stat": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": 400,
          "fontSize": "0.78rem",
          "lineHeight": 1.3,
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        },
        "$description": ".hero-stat-label"
      },
      "stat-value": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.display}",
          "fontWeight": 500,
          "fontSize": {
            "min": "1.5rem",
            "preferred": "2.6vw",
            "max": "2rem",
            "css": "clamp(1.5rem, 2.6vw, 2rem)"
          },
          "lineHeight": 1,
          "letterSpacing": "0"
        },
        "$description": ".hero-stat-value"
      }
    }
  },
  "spacing": {
    "scale": {
      "4": { "$type": "dimension", "$value": "4px" },
      "8": { "$type": "dimension", "$value": "8px" },
      "12": { "$type": "dimension", "$value": "12px" },
      "16": { "$type": "dimension", "$value": "16px" },
      "20": { "$type": "dimension", "$value": "20px" },
      "24": { "$type": "dimension", "$value": "24px" },
      "32": { "$type": "dimension", "$value": "32px" },
      "48": { "$type": "dimension", "$value": "48px" },
      "64": { "$type": "dimension", "$value": "64px" },
      "80": { "$type": "dimension", "$value": "80px" },
      "112": { "$type": "dimension", "$value": "112px" }
    },
    "named": {
      "button-y": { "$type": "dimension", "$value": "0.8rem", "$description": "Button vertical padding" },
      "button-x": { "$type": "dimension", "$value": "1.4rem", "$description": "Button horizontal padding" },
      "button-gap": { "$type": "dimension", "$value": "8px" },
      "card": { "$type": "dimension", "$value": "1.5rem" },
      "tile-gap": { "$type": "dimension", "$value": "1.5rem" }
    }
  },
  "layout": {
    "shell": {
      "inline": {
        "$type": "dimension",
        "$value": {
          "min": "1.25rem",
          "preferred": "4vw",
          "max": "2.5rem",
          "css": "clamp(1.25rem, 4vw, 2.5rem)"
        },
        "$description": ".editorial-shell horizontal padding"
      },
      "max-width": {
        "$type": "dimension",
        "$value": "1180px",
        "$description": ".editorial-shell max-width"
      }
    },
    "section": {
      "block": {
        "$type": "dimension",
        "$value": {
          "min": "3.5rem",
          "preferred": "8vw",
          "max": "7rem",
          "css": "clamp(3.5rem, 8vw, 7rem)"
        },
        "$description": "--section-pad / .editorial-section"
      }
    },
    "measure": {
      "prose": {
        "$type": "dimension",
        "$value": "68ch",
        "$description": "--measure"
      }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px", "$description": "--border-radius-sm" },
    "md": { "$type": "dimension", "$value": "6px", "$description": "--border-radius-md" },
    "lg": { "$type": "dimension", "$value": "6px", "$description": "--border-radius-lg (same as md per brief)" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "none" },
    "md": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0",
        "color": "rgba(28, 43, 34, 0.06)"
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0",
        "color": "rgba(28, 43, 34, 0.1)"
      }
    }
  },
  "contrast": {
    "$description": "WCAG AA pairs checked by scripts/contrast-check.mjs",
    "pairs": [
      { "name": "body text", "fg": "#1c2b22", "bg": "#faf6ec", "size": "normal" },
      { "name": "body text on sand", "fg": "#1c2b22", "bg": "#f0e9d8", "size": "normal" },
      { "name": "supporting copy", "fg": "#61685e", "bg": "#faf6ec", "size": "normal" },
      { "name": "supporting copy on sand", "fg": "#61685e", "bg": "#f0e9d8", "size": "normal" },
      { "name": "gold CTA label", "fg": "#1c2b22", "bg": "#d98e04", "size": "normal" },
      { "name": "gold CTA hover label", "fg": "#1c2b22", "bg": "#c98304", "size": "normal" },
      { "name": "gold eyebrow on cream", "fg": "#8a5a02", "bg": "#faf6ec", "size": "normal" },
      { "name": "gold eyebrow on sand", "fg": "#8a5a02", "bg": "#f0e9d8", "size": "normal" },
      { "name": "clay CTA label", "fg": "#faf6ec", "bg": "#b5502e", "size": "normal" },
      { "name": "clay CTA hover label", "fg": "#faf6ec", "bg": "#97401f", "size": "normal" },
      { "name": "ink CTA label", "fg": "#faf6ec", "bg": "#1c2b22", "size": "normal" },
      { "name": "clay accent text", "fg": "#97401f", "bg": "#f0e9d8", "size": "normal" },
      { "name": "clay nav link", "fg": "#97401f", "bg": "#faf6ec", "size": "normal" },
      { "name": "gold eyebrow on ink", "fg": "#d98e04", "bg": "#1c2b22", "size": "normal" },
      { "name": "cream heading on ink", "fg": "#faf6ec", "bg": "#1c2b22", "size": "large" }
    ]
  },
  "cssMap": {
    "$description": "Token path → CSS custom property in src/index.css",
    "color.brand.plantation-ink": "--plantation-ink",
    "color.brand.plantation-ink-soft": "--plantation-ink-soft",
    "color.brand.heritage-gold": "--heritage-gold",
    "color.brand.heritage-gold-deep": "--heritage-gold-deep",
    "color.brand.heritage-gold-ink": "--heritage-gold-ink",
    "color.brand.terracotta-clay": "--terracotta-clay",
    "color.brand.terracotta-clay-deep": "--terracotta-clay-deep",
    "color.brand.sugarcane-cream": "--sugarcane-cream",
    "color.brand.sand": "--sand",
    "color.brand.muted-sage": "--muted-sage",
    "color.supporting.ocean-teal": "--ocean-teal",
    "color.border.hairline": "--hairline",
    "color.border.hairline-strong": "--hairline-strong",
    "color.border.hairline-invert": "--hairline-invert",
    "fontFamily.display": "--font-display",
    "fontFamily.body": "--font-body",
    "fontFamily.sans": "--font-sans",
    "radius.sm": "--border-radius-sm",
    "radius.md": "--border-radius-md",
    "radius.lg": "--border-radius-lg",
    "layout.measure.prose": "--measure",
    "layout.section.block": "--section-pad"
  }
}
